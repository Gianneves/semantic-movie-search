DB_TYPE=postgres
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=
DB_HOST=localhost
DB_PORT=5432
DB_AUTOLOADENTITIES=1
DB_SYNCHRONIZE=1

PORT=3000
NODE_ENV=dev

# OpenAI
OPENAI_API_KEY=

# API The Movie Database (TMDB)
THEMOVIEDB_API_KEY=
READ_TOKEN_API=

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Fila usada pelo notification-service (publisher e consumer precisam ser iguais)
NOTIFICATION_QUEUE=notification_queue

# SMTP (Resend: host smtp.resend.com, user "resend", pass = API key re_...)
# Para testes locais, o sandbox do Mailtrap também funciona
# (host sandbox.smtp.mailtrap.io, porta 2525, user/pass do inbox).
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=465
EMAIL_USER=resend
EMAIL_PASSWORD=re_SEU_TOKEN_AQUI
EMAIL_FROM=no-reply@SEU_DOMINIO_VERIFICADO.com
